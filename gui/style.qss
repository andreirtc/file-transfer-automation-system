/* 
  Windows 11 Fluent Design Light Theme for PySide6
  Clean, flat, rounded corners, soft shadows.
*/

QWidget {
    font-family: "Segoe UI Variable Display", "Segoe UI", "sans-serif";
    font-size: 13px;
    color: #202020;
}

QMainWindow {
    background-color: #F3F3F3; /* Simulated Mica light */
}

/* Group Boxes / Cards */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 8px;
    margin-top: 16px;
    padding-top: 16px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: #1A1A1A;
}

/* ToolBar */
QToolBar {
    background-color: #F3F3F3;
    border: none;
    border-bottom: 1px solid #E5E5E5;
    spacing: 8px;
    padding: 4px 8px;
}

QToolBar QToolButton {
    background-color: transparent;
    border-radius: 4px;
    padding: 6px;
}

QToolBar QToolButton:hover {
    background-color: #E5E5E5;
}

QToolBar QToolButton:pressed {
    background-color: #CCCCCC;
}

/* Status Bar */
QStatusBar {
    background-color: #F3F3F3;
    border-top: 1px solid #E5E5E5;
    color: #555555;
}

/* Buttons */
QPushButton {
    background-color: #FDFDFD;
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    padding: 6px 16px;
    color: #1A1A1A;
}

QPushButton:hover {
    background-color: #F3F3F3;
}

QPushButton:pressed {
    background-color: #E5E5E5;
    color: #555555;
}

QPushButton:disabled {
    background-color: #F9F9F9;
    border: 1px solid #E5E5E5;
    color: #AAAAAA;
}

/* Primary Button Action (Sync Now style) */
QPushButton#primaryButton {
    background-color: #005FB8;
    border: 1px solid #005FB8;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #0056A3;
}

QPushButton#primaryButton:pressed {
    background-color: #004A8C;
}

QPushButton#primaryButton:disabled {
    background-color: #CCCCCC;
    border: 1px solid #CCCCCC;
    color: #FFFFFF;
}

/* Start/Stop Monitoring Buttons */
QPushButton#startButton {
    background-color: #107C10;
    border: 1px solid #107C10;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton#startButton:hover { background-color: #0F6B0F; }
QPushButton#startButton:disabled { background-color: #CCCCCC; border: 1px solid #CCCCCC; }

QPushButton#stopButton {
    background-color: #C42B1C;
    border: 1px solid #C42B1C;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton#stopButton:hover { background-color: #A82418; }
QPushButton#stopButton:disabled { background-color: #CCCCCC; border: 1px solid #CCCCCC; }


/* Table View */
QTableView {
    background-color: #FFFFFF;
    border: 1px solid #E5E5E5;
    border-radius: 8px;
    gridline-color: transparent;
    selection-background-color: #F3F3F3;
    selection-color: #1A1A1A;
    outline: none; /* removes focus rect */
}

QTableView::item {
    padding: 6px 8px;
    border-bottom: 1px solid #F0F0F0;
}

QTableView::item:selected {
    background-color: #F3F3F3;
    border-radius: 4px;
}

QHeaderView::section {
    background-color: #FFFFFF;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #E5E5E5;
    font-weight: 600;
    color: #555555;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #FAFAFA;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #CCCCCC;
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: #999999;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

/* Form Controls (Inputs, Combo, SpinBox) */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D1D1;
    border-radius: 4px;
    padding: 5px 8px;
    border-bottom: 2px solid #D1D1D1;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QPlainTextEdit:focus {
    border-bottom: 2px solid #005FB8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}
